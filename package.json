{
  "name": "@petai/ai-computer-agent",
  "version": "1.0.0",
  "description": "AI brain / orchestrator for remote computer-control — plans structured actions from screenshots and natural language",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "postinstall": "npm run build",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "start:server": "tsx src/server.ts",
    "dev:server": "tsx watch src/server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist"
  },
  "engines": {
    "node": "20.x"
  },
  "keywords": [
    "ai",
    "orchestrator",
    "computer-use",
    "vision",
    "agent"
  ],
  "license": "MIT",
  "dependencies": {
    "@types/node": "^22.10.5",
    "dotenv": "^16.4.7",
    "typescript": "^5.7.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "vitest": "^2.1.8"
  }
}
