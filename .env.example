# AI provider: "openrouter" | "gemini"
AI_PROVIDER=openrouter
AI_MODEL=google/gemini-2.5-flash

OPENROUTER_API_KEY=
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_NAME=PetAI Computer Agent

GEMINI_API_KEY=

MAX_AGENT_ITERATIONS=30
MAX_SAME_ACTION_RETRIES=3
AI_TIMEOUT_MS=60000

# HTTP adapter for computer-agent-backend (POST /v1/plan)
AI_HTTP_PORT=4000
# Optional shared secret — must match backend AI_SERVICE_API_KEY when set
AI_SERVICE_API_KEY=
