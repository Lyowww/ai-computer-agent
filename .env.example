# AI provider: "openrouter" | "gemini"
AI_PROVIDER=openrouter

# Model id for the selected provider
# OpenRouter examples: openai/gpt-4o, google/gemini-2.0-flash-001, anthropic/claude-3.5-sonnet
# Gemini examples: gemini-2.0-flash, gemini-1.5-pro
AI_MODEL=openai/gpt-4o

# Provider API keys (set only the one you use)
OPENROUTER_API_KEY=
GEMINI_API_KEY=

# Safety / loop limits
MAX_AGENT_ITERATIONS=30
MAX_SAME_ACTION_RETRIES=3

# Optional provider overrides
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
